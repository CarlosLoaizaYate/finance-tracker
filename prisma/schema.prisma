generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String?
  createdAt           DateTime             @default(now())
  cryptoSellCommission Float               @default(0)
  cryptoCommissionRate Float               @default(0.001)
  categories          Category[]
  expenseItems        ExpenseItem[]
  expenseRecords      ExpenseRecord[]
  stocks              Stock[]
  investmentTypes     InvestmentType[]
  incomeSources       IncomeSource[]
  incomeHistory       IncomeHistory[]
  budgetHistory       BudgetHistory[]
  stockTransactions   StockTransaction[]
  stockPriceSnapshots StockPriceSnapshot[]
  funds               Fund[]
  fundSnapshots       FundSnapshot[]
  fixedDepositGroups     FixedDepositGroup[]
  fixedDeposits          FixedDeposit[]
  fixedDepositSnapshots  FixedDepositSnapshot[]
  usdwPurchases          UsdwPurchase[]
  btcPurchases           BtcPurchase[]
  cryptoSnapshots        CryptoSnapshot[]
  mortgages              Mortgage[]
  mortgagePayments       MortgagePayment[]
  cardInstallments       CardInstallment[]
}

model Category {
  id               String            @id @default(uuid())
  name             String
  color            String
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  items            ExpenseItem[]
  cardInstallments CardInstallment[]

  @@unique([name, userId])
}

model ExpenseItem {
  id            String          @id @default(uuid())
  name          String
  monthlyBudget Int
  defaultDay    Int             @default(1)
  active        Boolean         @default(true)
  recurring     Boolean         @default(false)
  isImportant   Boolean         @default(false)
  excludeFromTotal Boolean      @default(false) // true = records still tracked/visible, but excluded from month/year/category expense totals (e.g. a credit-card-payment item whose spend is already counted via the individual purchases)
  categoryId    String
  userId        String
  category      Category        @relation(fields: [categoryId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  records       ExpenseRecord[]
  budgetHistory BudgetHistory[]
}

model ExpenseRecord {
  id           String      @id @default(uuid())
  day          Int         @default(1)
  month        Int
  year         Int
  realValue    Int
  comment      String      @default("")
  paidWithCard Boolean     @default(false) // true = paid with the credit card, regardless of category
  itemId       String
  userId       String
  item         ExpenseItem @relation(fields: [itemId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
}

// A purchase split into a fixed number of no-interest monthly installments
// ("cuotas") on the credit card. The monthly amount and which installment is
// current are derived from totalAmount/installments and today's date — no
// interest math, no need to re-enter it each month.
model CardInstallment {
  id           String    @id @default(uuid())
  name         String
  totalAmount  Int
  installments Int
  startMonth   Int       // 0-11
  startYear    Int
  categoryId   String?
  notes        String    @default("")
  createdAt    DateTime  @default(now())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  category     Category? @relation(fields: [categoryId], references: [id])
}

model Stock {
  id              String               @id @default(uuid())
  name            String
  typeId          String
  type            InvestmentType       @relation(fields: [typeId], references: [id])
  color           String
  createdAt       DateTime             @default(now())
  investedCapital Int
  sellCommission  Int                  @default(14875)
  active          Boolean              @default(true)
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  transactions    StockTransaction[]
  priceSnapshots  StockPriceSnapshot[]
}


model InvestmentType {
  id          String       @id @default(uuid())
  name        String
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  stocks      Stock[]
  funds       Fund[]

  @@unique([name, userId])
}

model IncomeSource {
  id      String          @id @default(uuid())
  name    String
  userId  String
  user    User            @relation(fields: [userId], references: [id])
  history IncomeHistory[]

  @@unique([name, userId])
}

model IncomeHistory {
  id             String       @id @default(uuid())
  amount         Int
  effectiveMonth Int
  effectiveYear  Int
  sourceId       String
  userId         String
  source         IncomeSource @relation(fields: [sourceId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([sourceId, effectiveMonth, effectiveYear])
}

model BudgetHistory {
  id             String      @id @default(uuid())
  amount         Int
  effectiveMonth Int
  effectiveYear  Int
  itemId         String
  userId         String
  item           ExpenseItem @relation(fields: [itemId], references: [id])
  user           User        @relation(fields: [userId], references: [id])

  @@unique([itemId, effectiveMonth, effectiveYear])
}

model StockTransaction {
  id              String     @id @default(uuid())
  investmentId    String
  quantity        Int        // Cantidad de acciones compradas
  priceUnit       Int        // Precio por acción (en centavos)
  commission      Int        // Comisión de la transacción (en centavos)
  transactionDate DateTime   // Fecha de la compra
  notes           String     @default("")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  userId          String

  stock           Stock  @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StockPriceSnapshot {
  id            String     @id @default(uuid())
  investmentId  String
  month         Int
  year          Int
  pricePerShare Int        // price per share at this month
  createdAt     DateTime   @default(now())
  userId        String
  stock         Stock  @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  user          User   @relation(fields: [userId], references: [id])

  @@unique([investmentId, month, year])
}

model Fund {
  id          String         @id @default(uuid())
  name        String
  color       String
  baseCapital Int
  startDate   DateTime       @default(now())
  typeId      String?
  createdAt   DateTime       @default(now())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  type        InvestmentType? @relation(fields: [typeId], references: [id])
  snapshots   FundSnapshot[]
}

model FundSnapshot {
  id           String   @id @default(uuid())
  fundId       String
  day          Int      @default(1)
  month        Int
  year         Int
  currentValue Int
  contribution Int      @default(0)
  createdAt    DateTime @default(now())
  userId       String
  fund         Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])

}

model FixedDepositGroup {
  id        String         @id @default(uuid())
  name      String
  entity    String
  createdAt DateTime       @default(now())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  cycles    FixedDeposit[]
}

model FixedDeposit {
  id             String                  @id @default(uuid())
  groupId        String
  capital        Int
  capitalAdded   Int
  interestRate   Float
  term           Int                     @default(90)
  termUnit       String                  @default("DAYS")
  startDate      DateTime
  endDate        DateTime
  earnedInterest Int?
  notes          String                  @default("")
  createdAt      DateTime                @default(now())
  userId         String
  group          FixedDepositGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id])
  snapshots      FixedDepositSnapshot[]
}

model FixedDepositSnapshot {
  id        String       @id @default(uuid())
  depositId String
  day       Int          @default(1)
  month     Int
  year      Int
  gain      Int
  createdAt DateTime     @default(now())
  userId    String
  deposit   FixedDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])

  @@unique([depositId, day, month, year])
}

// ── Crypto: COP -> USDW -> BTC ──────────────────────────────────────────

model UsdwPurchase {
  id            String   @id @default(uuid())
  date          DateTime
  copAmount     Float    // total COP paid for this purchase (includes commission)
  commissionCop Float    @default(0)
  usdwAmount    Float    // USDW actually received
  notes         String   @default("")
  createdAt     DateTime @default(now())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BtcPurchase {
  id             String   @id @default(uuid())
  date           DateTime
  usdwAmount     Float    // USDW handed over for this exchange (includes commission)
  commissionUsdw Float    @default(0)
  btcPriceUsdw   Float    // price of 1 BTC in USDW at the time of this exchange
  btcAmount      Float    // BTC actually received
  notes          String   @default("")
  createdAt      DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CryptoSnapshot {
  id          String   @id @default(uuid())
  day         Int      @default(1)
  month       Int
  year        Int
  usdCopRate  Float    // COP per 1 USD
  btcPriceUsd Float    // USD per 1 BTC
  usdwBalance Float?   // actual USDW balance on this date, if you want to track interest earned beyond purchases/exchanges
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, month, year])
}

// ── Debts: Mortgage ──────────────────────────────────────────────────

model Mortgage {
  id             String    @id @default(uuid())
  name           String
  entity         String
  principal      Int                    // original amount disbursed (COP)
  interestRate   Float                  // tasa pactada — contractual effective annual rate (%)
  subsidizedRate Float?                 // tasa cobrada — actual rate charged today, net of any government rate subsidy (%)
  subsidyRate    Float?                 // tasa de cobertura — the subsidy benefit itself (%), e.g. "Mi Casa Ya"
  subsidyEndDate DateTime?              // date the rate-coverage benefit is expected to end
  isUvrIndexed   Boolean   @default(false)
  termMonths     Int
  startDate      DateTime
  notes          String    @default("")
  createdAt      DateTime  @default(now())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       MortgagePayment[]
}

model MortgagePayment {
  id               String   @id @default(uuid())
  mortgageId       String
  date             DateTime
  principalPaid    Int                   // COP applied to principal
  interestPaid     Int      @default(0)  // COP of interest actually paid by the client (0 for a pure abono a capital)
  interestCovered  Int      @default(0)  // COP of interest covered by a rate subsidy/benefit, not paid by the client
  insurancePaid    Int      @default(0)  // COP of life/property insurance premiums paid alongside the cuota
  realBalance      Int?                  // "Saldo a la Fecha de Corte" — the bank's own reported balance for this period's cutoff (usually the 15th), when known. Authoritative over the derived balance when present.
  realBalanceDate  DateTime?             // The cutoff date that realBalance is measured as-of, per the bank statement — often a different date than `date` (which is when the payment was actually transferred).
  previousBalance     Int?               // "Saldo Anterior" — the bank's reported opening balance for this statement's period, as printed on the statement (not derived from the prior row — the bank's own figure can differ slightly).
  previousBalanceDate DateTime?          // The date previousBalance is measured as-of, per the bank statement.
  isExtra          Boolean  @default(false) // true = extra principal payment outside the regular cuota
  isEstimated      Boolean  @default(false) // true = principal/interest/insurance split is a trend-based guess, not yet confirmed by the real extracto. Cleared automatically once realBalance is set.
  notes            String   @default("")
  createdAt        DateTime @default(now())
  userId           String
  mortgage         Mortgage @relation(fields: [mortgageId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
